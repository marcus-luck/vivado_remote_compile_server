# Build server configuration. Copy to .env and edit; both the API and the worker
# read .env from the directory they are started in. Variables set in the real
# environment win over this file. Other variables placed here are passed on to
# the build command.

# Required ####################################################################

# Database, packages, logs, artifacts and work directories. A relative path is
# relative to the directory the processes are started in.
# On Windows keep this path short: Vivado fails on paths over 260 characters.
BUILDSERVER_DATA_DIR=data

# Vivado executable. Not needed if BUILDSERVER_BUILD_COMMAND is set.
BUILDSERVER_VIVADO=C:\Xilinx\Vivado\2023.2\bin\vivado.bat

# File that must be at the top level of a build package.
BUILDSERVER_BUILD_SCRIPT=build.tcl

# Directory, relative to the package root, that is zipped as the artifacts.
# {name} is the build name.
BUILDSERVER_ARTIFACT_DIR=bitfiles/generated/{name}

# Optional ####################################################################

# Full build command as a JSON list, {name} is the build name. Replaces the
# Vivado command line built from BUILDSERVER_VIVADO and
# BUILDSERVER_BUILD_SCRIPT. Keep the single quotes around the list.
#BUILDSERVER_BUILD_COMMAND='["vivado", "-mode", "batch", "-source", "build.tcl", "-tclargs", "{name}"]'

# Seconds before a build is killed. Default 21600 (6 hours).
#BUILDSERVER_BUILD_TIMEOUT=21600

# Upload size limit in bytes. Default 2147483648 (2 GiB).
#BUILDSERVER_MAX_UPLOAD_BYTES=2147483648

# Set to 1 to keep the extracted package after the build, for debugging.
#BUILDSERVER_KEEP_WORKDIR=0

# Days after a build finishes before its package and artifacts are deleted.
# The build stays listed with its log. Unset or 0 keeps files forever.
#BUILDSERVER_RETENTION_DAYS=30

# Git executable the worker clones repositories with. Default: git on PATH.
#BUILDSERVER_GIT=git

# Example of a variable for the build command itself:
#XILINXD_LICENSE_FILE=2100@licence-host

# Sign-in (API server only) ###################################################
# Users sign in with Google. Create an OAuth client of type "Web application"
# in the Google Cloud console (APIs & Services > Credentials) and add
# <BUILDSERVER_PUBLIC_URL>/auth/callback as an authorised redirect URI.

# URL users open the server at. Google accepts http:// only for localhost;
# anything else needs https:// and a host name, not a bare IP address.
BUILDSERVER_PUBLIC_URL=http://localhost:8000

# Credentials of the Google OAuth client.
BUILDSERVER_GOOGLE_CLIENT_ID=
BUILDSERVER_GOOGLE_CLIENT_SECRET=

# Key that signs session cookies. Any long random string; changing it signs
# everybody out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BUILDSERVER_SESSION_SECRET=change-me

# Comma-separated Google accounts that are always administrators. This is how
# the first administrator gets in; others are added through /api/users.
BUILDSERVER_ADMIN_EMAILS=

# Optional: comma-separated email domains whose accounts may sign in as plain
# users without being added first, e.g. a Google Workspace domain.
#BUILDSERVER_ALLOWED_DOMAINS=example.com

# GitHub (API server only) ####################################################
# Optional: lets users link a GitHub account and build from its repositories.
# Create an OAuth App (GitHub > Settings > Developer settings > OAuth Apps)
# with <BUILDSERVER_PUBLIC_URL>/auth/github/callback as its callback URL.
#BUILDSERVER_GITHUB_CLIENT_ID=
#BUILDSERVER_GITHUB_CLIENT_SECRET=