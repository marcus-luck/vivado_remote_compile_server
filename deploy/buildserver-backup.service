# Daily backup of the build server database and .env, started by
# buildserver-backup.timer. deploy/buildserverctl provision fills in @ROOT@
# and @USER@ and installs it in /etc/systemd/system.
[Unit]
Description=Back up the build server database
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=@USER@
ExecStart=@ROOT@/deploy/buildserverctl backup
