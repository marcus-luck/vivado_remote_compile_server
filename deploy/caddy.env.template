# Settings and secrets for Caddy. Copy to caddy.env (git-ignored) and fill in.
#
# Kept apart from the build server's .env on purpose: only the caddy
# container gets it. The host name comes from BUILDSERVER_PUBLIC_URL in .env.

# The certificate: cloudflare (Let's Encrypt through a Cloudflare DNS
# challenge) or internal (Caddy's own CA; install its root certificate on
# the clients, see "HTTPS on the local network" in README.md).
CADDY_TLS=cloudflare

# With CADDY_TLS=cloudflare: an API token that can edit DNS of the host
# name's zone. Cloudflare dashboard > My Profile > API Tokens > Create Token
# > "Edit zone DNS" template, that zone.
CLOUDFLARE_API_TOKEN=
