# Secrets for Caddy. Copy to caddy.env (git-ignored) and fill in.
#
# Kept apart from the build server's .env on purpose: only the caddy
# container gets it.

# Cloudflare API token that can edit DNS of the drystone.solutions zone.
# Cloudflare dashboard > My Profile > API Tokens > Create Token >
# "Edit zone DNS" template, zone drystone.solutions.
CLOUDFLARE_API_TOKEN=
